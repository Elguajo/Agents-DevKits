{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agents DevKits blinded live skill-evaluation judge record",
  "type": "object",
  "required": ["schema_version", "judge_id", "pilot_id", "artifacts", "dimensions"],
  "properties": {
    "schema_version": {"const": 1},
    "judge_id": {"type": "string", "minLength": 1},
    "pilot_id": {"type": "string", "minLength": 1},
    "artifacts": {"type": "object", "required": ["Artifact A", "Artifact B"], "additionalProperties": false, "properties": {"Artifact A": {"type": "string", "minLength": 1}, "Artifact B": {"type": "string", "minLength": 1}}},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "winner", "reason"], "properties": {"name": {"type": "string", "minLength": 1}, "winner": {"enum": ["Artifact A", "Artifact B", "tie", "unavailable"]}, "reason": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
