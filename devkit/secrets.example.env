# Copy this to secrets.local.env and fill machine-local secrets.
# secrets.local.env is ignored by git.

export CONTEXT7_API_KEY="<your-context7-api-key>"

# Optional MCP values. Leave unset to keep safe placeholders in the generated
# Codex config; doctor will report their associated MCP as not ready.
export ANYTYPE_HEADERS="<your-anytype-openapi-headers>"
export AFFINE_BASE_URL="<your-affine-base-url>"
export AFFINE_TOOL_PROFILE="<your-affine-tool-profile>"
export IDEON_MCP_TOKEN="<your-ideon-mcp-token>"
